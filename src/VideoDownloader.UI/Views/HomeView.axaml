<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VideoDownloader.UI.ViewModels"
             xmlns:models="using:VideoDownloader.Core.Models"
             xmlns:conv="using:VideoDownloader.UI.Converters"
             x:Class="VideoDownloader.UI.Views.HomeView"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Resources>
        <conv:EnumToBoolConverter x:Key="EnumToBoolConverter" />
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,10" Spacing="12">
            <!-- Logo -->
            <Image Source="avares://VideoDownloader.UI/Assets/Logo.png"
                   Width="80" Height="80"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,4" />

            <!-- URL Input Area -->
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto">
                <TextBox Grid.Column="0"
                         Text="{Binding Url}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="100"
                         PlaceholderText="每行输入一个视频地址&#x0a;例如：&#x0a;https://www.youtube.com/watch?v=xxx&#x0a;https://www.bilibili.com/video/BVxxx"
                         VerticalContentAlignment="Top" />
                <Button Grid.Column="1"
                        Margin="10,0,0,0"
                        Width="80" Height="100"
                        Command="{Binding QueryVideosCommand}"
                        Cursor="Hand"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        ToolTip.Tip="解析视频">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <PathIcon Data="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"
                                  Width="24" Height="24" />
                        <TextBlock Text="解析" FontSize="12" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Batch Controls Bar -->
            <Border Padding="12,8"
                    CornerRadius="8"
                    Background="{DynamicResource SemiColorFillQuaternary}"
                    IsVisible="{Binding HasVideoItems}">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <CheckBox Grid.Column="0"
                              Content="全选"
                              IsChecked="{Binding IsAllSelected}"
                              VerticalAlignment="Center" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="统一清晰度:" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SemiColorTextSecondary}" />
                        <ComboBox Width="120"
                                  ItemsSource="{Binding BatchResolutions}"
                                  SelectedItem="{Binding BatchResolution}"
                                  VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Grid.Column="3" Margin="12,0,0,0"
                            Classes="accent"
                            Command="{Binding DownloadSelectedCommand}"
                            Cursor="Hand"
                            VerticalContentAlignment="Center"
                            Height="36">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"
                                      Width="16" Height="16" />
                            <TextBlock Text="批量下载所选" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Video Items List -->
            <ItemsControl ItemsSource="{Binding VideoItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:VideoItemViewModel">
                        <Border Margin="0,4" Padding="12" CornerRadius="8"
                                Background="{DynamicResource SemiColorFillQuaternary}">
                            <Panel>
                                <!-- Querying State -->
                                <StackPanel Orientation="Horizontal" Spacing="12"
                                            IsVisible="{Binding Status, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:VideoItemStatus.Querying}}">
                                    <ProgressBar IsIndeterminate="True" Width="32" Height="32" />
                                    <TextBlock Text="{Binding Url}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SemiColorTextSecondary}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Error State -->
                                <StackPanel Orientation="Horizontal" Spacing="12"
                                            IsVisible="{Binding Status, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:VideoItemStatus.Error}}">
                                    <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                                              Width="24" Height="24" Foreground="{DynamicResource SemiColorDanger}" />
                                    <TextBlock Text="{Binding Url}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SemiColorDanger}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="解析失败" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SemiColorTextSecondary}" />
                                </StackPanel>

                                <!-- Ready / Downloading / Downloaded State -->
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                                      IsVisible="{Binding Status, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:VideoItemStatus.Ready}}">
                                    <!-- Checkbox -->
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                              VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <!-- Thumbnail -->
                                    <Border Grid.Column="1" Width="120" Height="68"
                                            CornerRadius="6" ClipToBounds="True" Margin="0,0,12,0">
                                        <Image Source="{Binding ThumbnailBitmap}" Stretch="UniformToFill" />
                                    </Border>
                                    <!-- Title -->
                                    <TextBlock Grid.Column="2" Text="{Binding VideoInfo.Title}"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               MaxLines="2" VerticalAlignment="Center"
                                               Margin="0,0,12,0" />
                                    <!-- Quality ComboBox -->
                                    <ComboBox Grid.Column="3" Width="160"
                                              ItemsSource="{Binding QualityOptions}"
                                              SelectedItem="{Binding SelectedFormat}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:VideoFormat">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding QualityLabel}" />
                                                    <TextBlock Text="{Binding FileSizeStr}"
                                                               Foreground="{DynamicResource SemiColorTextSecondary}"
                                                               FontSize="12" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <!-- Download Button -->
                                    <Button Grid.Column="4" Width="44" Height="44"
                                            Background="Transparent" BorderThickness="0"
                                            Command="{Binding DownloadCommand}"
                                            Cursor="Hand"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            ToolTip.Tip="下载此视频">
                                        <PathIcon Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"
                                                  Width="22" Height="22"
                                                  Foreground="{DynamicResource SemiColorPrimary}" />
                                    </Button>
                                </Grid>

                                <!-- Downloading State -->
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                                      IsVisible="{Binding Status, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:VideoItemStatus.Downloading}}">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                              VerticalAlignment="Center" Margin="0,0,8,0" IsEnabled="False" />
                                    <Border Grid.Column="1" Width="120" Height="68"
                                            CornerRadius="6" ClipToBounds="True" Margin="0,0,12,0">
                                        <Image Source="{Binding ThumbnailBitmap}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="6">
                                        <TextBlock Text="{Binding VideoInfo.Title}"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        <ProgressBar Value="{Binding DownloadProgress}" Maximum="100"
                                                     Height="6" Foreground="{DynamicResource SemiColorPrimary}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="8,0,0,0"
                                               Text="{Binding DownloadProgress, StringFormat={}{0:F1}%}"
                                               Foreground="{DynamicResource SemiColorTextSecondary}"
                                               Width="50" TextAlignment="Right" />
                                </Grid>

                                <!-- Downloaded State -->
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                                      IsVisible="{Binding Status, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:VideoItemStatus.Downloaded}}">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                              VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Border Grid.Column="1" Width="120" Height="68"
                                            CornerRadius="6" ClipToBounds="True" Margin="0,0,12,0">
                                        <Image Source="{Binding ThumbnailBitmap}" Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding VideoInfo.Title}"
                                               TextTrimming="CharacterEllipsis" MaxLines="2"
                                               VerticalAlignment="Center" />
                                    <PathIcon Grid.Column="3"
                                              Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                                              Width="24" Height="24"
                                              Foreground="Green"
                                              VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>
                            </Panel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
